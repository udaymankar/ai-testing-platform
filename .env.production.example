# Copy this file to .env.production on the Oracle VM, then replace placeholders.
# Use a free DuckDNS subdomain or a domain that you control. Never commit .env.production.
SITE_DOMAIN=replace-with-your-subdomain.duckdns.org
ACME_EMAIL=you@example.com

POSTGRES_DB=aitesting
POSTGRES_USER=aitesting_app
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# Optional; leave blank to use the deterministic test-plan fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BROWSER_TIMEOUT_SECONDS=20
MAX_TESTS_PER_RUN=10
